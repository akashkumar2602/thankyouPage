# Copy this file to ".env" and fill in your real values from Adobe Data Collection UI.

# Datastream / Edge Configuration ID (Data Collection UI > Datastreams)
EDGE_CONFIG_ID=REPLACE_WITH_YOUR_DATASTREAM_ID
ORG_ID = 2ACF35355F50F9060A495CFB@AdobeOrg

# Optional: specific sandbox name if you use non-default sandboxes
ORG_SANDBOX=prod

# The LOCATION portion of the code-based experience surface (just the fragment,
# e.g. "#thankyou-return-prompt"). Alloy composes the full surface URI as
# web://<current host><current path>#<this value>. This must exactly match the
# "Location" you configure in the AJO code-based experience channel configuration
# for the Web platform (see README Part 3).
DECISION_SCOPE=#thankyou-return-prompt

# Set to "true" to bypass real AEP calls and use the local mock proposition endpoint.
# Use this FIRST to validate the UI, then flip to "false" once EDGE_CONFIG_ID + journey are live.
MOCK_MODE=true

PORT=3000
